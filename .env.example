# Địa chỉ công khai chính thức của hệ thống (dùng cho Google OAuth Redirect URI)
NEXT_PUBLIC_APP_URL=https://vtvl.utehub.vn

# Cấu hình Google OAuth 2.0 trực tiếp (Google Cloud Console → Credentials → Web Application)
# Authorized JavaScript origins: https://vtvl.utehub.vn
# Authorized redirect URIs:      https://vtvl.utehub.vn/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_HD=hcmute.edu.vn

# Khóa bí mật ký JWT phiên người dùng & Quản trị viên phía máy chủ Next.js
ADMIN_SERVER_SECRET=

# Cấu hình cơ sở dữ liệu PostgreSQL 16 độc lập (Docker Compose trên VPS — 127.0.0.1:5436)
POSTGRES_USER=utevtvl_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=utevtvl_db
DATABASE_URL=postgresql://utevtvl_admin:change_me_in_production@postgres:5432/utevtvl_db?schema=public
