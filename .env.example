# Sao chép tệp này thành .env.local và điền thông số dự án Supabase của bạn
# Tệp .env.local đã nằm trong .gitignore (không bao giờ đẩy lên GitHub)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khóa Service Role phía máy chủ Next.js (khuyên dùng để ghi/đọc dữ liệu qua RLS an toàn)
SUPABASE_SERVICE_ROLE_KEY=

# Khóa bí mật ký phiên Quản trị viên
ADMIN_SERVER_SECRET=
